# Copy to `.env.local`. No secrets here: NEXT_PUBLIC_ values reach the browser.

# Base URL of the FastAPI backend, including its /api prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Serve API responses from Mock Service Worker fixtures. Leave on until the
# backend has the document status and episode view endpoints.
NEXT_PUBLIC_USE_MOCKS=true

NEXT_PUBLIC_MAX_UPLOAD_MB=20
NEXT_PUBLIC_POLL_MS=2000
NEXT_PUBLIC_POLL_MAX_MS=5000
NEXT_PUBLIC_POLL_TIMEOUT_MIN=15
NEXT_PUBLIC_CLIENT_LOG=false
NEXT_PUBLIC_DEBUG=false
