# Copy to `.env` and fill in. Never commit real secrets. (NFR-6)

ENVIRONMENT=development

# Model / provider keys (leave blank until a feature needs them)
LLM_API_KEY=
TTS_API_KEY=

# Infra (used once the session/data layers are wired)
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///./data/papercast.db

# Frontend origin for CORS
CORS_ORIGINS=["http://localhost:3000"]
